{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4K Wallpaper Desktop",
  "version": "0.2.2",
  "identifier": "com.local.wallpaperdesktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "4K Wallpaper Desktop",
        "width": 1120,
        "height": 800,
        "minWidth": 760,
        "minHeight": 620,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/presets/"
    ]
  }
}
